<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    libSandy profile granting devicecheckd (sandboxed; confirmed via direct
    open()/write() probes returning ENOENT/EPERM for arbitrary paths including
    /tmp) read access to the one namespaced file `oracled` uses to hand it a
    forced App ID. Applied via libSandy_applyProfile("OracledDCPatch") from
    this tweak's %ctor (see ~/repositories/geoshim's identical pattern).

    roothide caveat (per GeoShim prior art): the roothide libSandy fork
    jbroot()s each extension path before issuing it, and devicecheckd (a
    genuine, non-jbroot Apple daemon) needs the REAL, non-jbroot path to
    actually resolve — confirmed necessary here since devicecheckd's own
    open()/read() probes operate on the true filesystem, not a jbroot-relative
    view.
  -->
  <key>AllowedProcesses</key>
  <array>
    <string>devicecheckd</string>
    <string>com.apple.devicecheckd</string>
    <string>*</string>
  </array>
  <key>Extensions</key>
  <array>
    <dict>
      <key>type</key>
      <string>file</string>
      <key>extension_class</key>
      <string>com.apple.app-sandbox.read</string>
      <key>path</key>
      <string>/var/mobile/Library/Preferences/xyz.regulad.aaoracled.forge-appid.txt</string>
    </dict>
  </array>
</dict>
</plist>
